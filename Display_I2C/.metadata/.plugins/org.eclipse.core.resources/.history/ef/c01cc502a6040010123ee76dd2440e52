/* USER CODE BEGIN 4 */
void lcd_send_cmd (char cmd)
{
  char data_u, data_l;
  data_u = (cmd&0xf0);
  data_l = ((cmd<<4)&0xf0);
  uint8_t data_t[4];
  data_t[0] = data_u|0x0C;  //en=1, rs=0 -> bxxxx1100
  data_t[1] = data_u|0x08;  //en=0, rs=0 -> bxxxx1000
  data_t[2] = data_l|0x0C;  //en=1, rs=0 -> bxxxx1100
  data_t[3] = data_l|0x08;  //en=0, rs=0 -> bxxxx1000
  	HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[0], 1, 100);
  	HAL_Delay(5);
  	HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[1], 1, 100);
  	HAL_Delay(5);
  	HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[2], 1, 100);
  	HAL_Delay(5);
  	HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[3], 1, 100);
  	HAL_Delay(5);


}

void lcd_send_data (char data)
{
	char data_u, data_l;
	uint8_t data_t[4];
	data_u = (data&0xf0);
	data_l = ((data<<4)&0xf0);
	data_t[0] = data_u|0x0D;  //en=1, rs=1 -> bxxxx1101
	data_t[1] = data_u|0x09;  //en=0, rs=1 -> bxxxx1001
	data_t[2] = data_l|0x0D;  //en=1, rs=1 -> bxxxx1101
	data_t[3] = data_l|0x09;  //en=0, rs=1 -> bxxxx1001
		HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[0], 1, 100);
		HAL_Delay(5);
		HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[1], 1, 100);
		HAL_Delay(5);
		HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[2], 1, 100);
		HAL_Delay(5);
		HAL_I2C_Master_Transmit (&hi2c2, SLAVE_ADDRESS_LCD,&data_t[3], 1, 100);
		HAL_Delay(5);
}



void LCD_Init (void)
{
//	LCD_EN_LOW;					// Enable triggers H>L
//	LCD_RS_LOW;
//	LCD_RW_LOW;

	HAL_Delay(500); // wait for complete power up
	for (uint8_t i = 0; i < 3;i++)
	{
		lcd_send_cmd(0x30);	// function set	0 0 1 1 * * * * for init to 8bit-interface
		HAL_Delay(5);			//
		/*
		D7.............D0
		0 0 1 DL N F — — Sets interface data length(DL), number of display lines (N), and character font (F).
		DL = 1: 8 bits,			DL = 0:  4 bits
		N = 1:	2 lines,		N = 0:  1 line
		F = 1:	5 x 10 dots,	F = 0:  5 x 8 dots
		*/
	}
	lcd_send_cmd(0x28);	// function set	0 0 1 0 1 0 0 0: 4bit, 2 lines, 5x8px charset
	HAL_Delay(5);
	// from here according to datasheet busy should be useable
	lcd_send_cmd(0x08);	// Display control: Display off
	HAL_Delay(5);
	lcd_send_cmd(0x01);	// Display clear
	HAL_Delay(5);
	lcd_send_cmd(0x06);	// Entry mode increment, no shift
	HAL_Delay(5);
	lcd_send_cmd(0x0C);	// Display on control: Display on, cursor off, blink off
	//LCD_WriteCmdReg_NoBusy(0x0F);	// Display on control: Display on, cursor on, blink on
	LCD_Home();
	LCD_Clear();
	setRowOffsets(0x00, 0x40, 0x00 + NUMCOLS, 0x40 + NUMCOLS);
}


//--------------------------------------------------------
void setRowOffsets(int row0, int row1, int row2, int row3)
{
	_row_offsets[0] = row0;
	_row_offsets[1] = row1;
	_row_offsets[2] = row2;
	_row_offsets[3] = row3;
}


//----------------------------------------
void LCD_SetCursor(uint8_t col, uint8_t row)
{
	const size_t max_rows = 2;
	const size_t max_cols = 16;

	if ( col >= max_cols )
		col = max_cols - 1;    // we count cols starting w/0
	if ( row >= max_rows )
		row = max_rows - 1;    // we count rows starting w/0
	lcd_send_cmd(LCD_SETDDRAMADDR | (col + _row_offsets[row]));
}


//----------------------------------------
void LCD_Home (void)
{
	lcd_send_cmd(0x02);
}


//----------------------------------------
void LCD_Clear (void)
{
	lcd_send_cmd(0x01);
}


//----------------------------------------
void LCD_PrintStr(char * Str)
{
	while (*Str!=0)
	{
		lcd_send_data((uint8_t)*Str);
		Str++;
	}
}
// End LCD -------------------------------


//----------------------------------------
void LCD_PrintCh(char ch)
{
	lcd_send_data((uint8_t)ch);
}

