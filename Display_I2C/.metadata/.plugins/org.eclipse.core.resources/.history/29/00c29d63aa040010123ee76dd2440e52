void LCD_Init (void)
{
//	LCD_EN_LOW;					// Enable triggers H>L
//	LCD_RS_LOW;
//	LCD_RW_LOW;

	HAL_Delay(500); // wait for complete power up
	for (uint8_t i = 0; i < 3;i++)
	{
		LCD_SendCommand(0x03);	// function set	0 0 1 1 * * * * for init to 8bit-interface
		HAL_Delay(5);			//
		/*
		D7.............D0
		0 0 1 DL N F — — Sets interface data length(DL), number of display lines (N), and character font (F).
		DL = 1: 8 bits,			DL = 0:  4 bits
		N = 1:	2 lines,		N = 0:  1 line
		F = 1:	5 x 10 dots,	F = 0:  5 x 8 dots
		*/
	}
	LCD_SendCommand(0x28);	// function set	0 0 1 0 1 0 0 0: 4bit, 2 lines, 5x8px charset
	HAL_Delay(5);
	// from here according to datasheet busy should be useable
	LCD_SendCommand(0x08);	// Display control: Display off
	HAL_Delay(5);
	LCD_SendCommand(0x01);	// Display clear
	HAL_Delay(5);
	LCD_SendCommand(0x06);	// Entry mode increment, no shift
	HAL_Delay(5);
	LCD_SendCommand(0x0C);	// Display on control: Display on, cursor off, blink off
}

void LCD_SendInternal(uint8_t data, uint8_t flags) {
    uint8_t high_nibble = (data & 0xF0) | flags | 0x08;  // Enable = 1
    uint8_t low_nibble = ((data << 4) & 0xF0) | flags | 0x08;

    HAL_I2C_Master_Transmit(&hi2c2, LCD_ADDRESS, &high_nibble, 1, HAL_MAX_DELAY);
    HAL_Delay(1);
    high_nibble &= ~0x08;  // Enable = 0
    HAL_I2C_Master_Transmit(&hi2c2, LCD_ADDRESS, &high_nibble, 1, HAL_MAX_DELAY);

    HAL_I2C_Master_Transmit(&hi2c2, LCD_ADDRESS, &low_nibble, 1, HAL_MAX_DELAY);
    HAL_Delay(1);
    low_nibble &= ~0x08;  // Enable = 0
    HAL_I2C_Master_Transmit(&hi2c2, LCD_ADDRESS, &low_nibble, 1, HAL_MAX_DELAY);
}

void LCD_SendCommand(uint8_t cmd) {
    LCD_SendInternal(cmd, 0x00);
}

void LCD_SendChar(char data) {
    LCD_SendInternal(data, 0x01);
}


//----------------------------------------
void LCD_SetCursor(uint8_t row, uint8_t col)
{
	uint8_t offsets[] = {0x00, 0x40};
	LCD_SendCommand(0x80 | (col + offsets[row]));
}


//----------------------------------------
void LCD_Home (void)
{
	LCD_SendCommand(0x02);
}


//----------------------------------------
void LCD_Clear (void)
{
	LCD_SendCommand(0x01);
}


//----------------------------------------
void LCD_PrintStr(char * Str)
{
	while (*Str)
		LCD_SendChar(*Str++);

}
