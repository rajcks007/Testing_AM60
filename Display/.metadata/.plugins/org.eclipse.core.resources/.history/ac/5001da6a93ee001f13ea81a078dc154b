{
	//cli();
	LCD_EN_LOW;
	_delay_us(1);
	LCD_EN_HIGH;
	_delay_us(1);
	LCD_EN_LOW;
	//_delay_us(100);
	//sei();
}

//----------------------------------------
void LCD_SetCursor(uint8_t col, uint8_t row)
{
	const size_t max_rows = 2;
	const size_t max_cols = 16;

	if ( col >= max_cols )
		col = max_cols - 1;    // we count cols starting w/0
	if ( row >= max_rows )
		row = max_rows - 1;    // we count rows starting w/0
	LCD_WriteCmdReg(LCD_SETDDRAMADDR | (col + _row_offsets[row]));
}

//----------------------------------------
void LCD_WriteCmdReg (uint8_t Byte)
{
	LCD_WaitBusy();
	cli();
	LCD_DATAPORT_DIR = 0xFF;
	LCD_DATAPORT_OUT = Byte;
	LCD_RS_CMD;
	LCD_RW_LOW;
	//_delay_us(1); // Setup time RS/RW to EN min. 40ns
	//LCD_EN_HIGH;
	//_delay_us(1);
	//LCD_EN_LOW;
	LCD_EnablePulse();
	sei();
}


//----------------------------------------
void LCD_WriteCmdReg_NoBusy (uint8_t Byte) // used for initialization when busy is nonfunctional
{
	cli();
	LCD_DATAPORT_DIR = 0xFF;
	LCD_DATAPORT_OUT = Byte;
	LCD_RS_CMD;
	LCD_RW_LOW;
	LCD_EnablePulse();
	//_delay_us(1);	// Setup time RS/RW to EN min. 40ns
	//LCD_EN_HIGH;
	//_delay_us(1);
	//LCD_EN_LOW;
	sei();
}


//----------------------------------------
uint8_t LCD_ReadCmdReg (void)
{	uint8_t inByte;
	LCD_WaitBusy();
	cli();
	LCD_DATAPORT_DIR = 0x00;
	LCD_RS_CMD;
	LCD_RW_HIGH;


	//LCD_EnablePulse(); // Doesn't work in read, for data needs to be read during high pahse of EN
	_delay_us(1); // Setup time RS/RW to EN min. 40ns
	LCD_EN_LOW;
	_delay_us(1);
	LCD_EN_HIGH;
	_delay_us(1);
	inByte = LCD_DATAPORT_IN;
	LCD_EN_LOW;
	//_delay_us(100);

	LCD_DATAPORT_DIR = 0xFF; // for better traceability during development: set to defined level
	LCD_DATAPORT_OUT = 0x00;
	sei();
	return inByte;

}

//----------------------------------------
void LCD_WriteDataReg (uint8_t Byte)
{
	LCD_WaitBusy();
	cli();
	LCD_DATAPORT_DIR = 0xFF;
	LCD_DATAPORT_OUT = Byte;
	LCD_RS_DATA;
	LCD_RW_LOW;		// write
	LCD_EnablePulse();
	_delay_us(1);	// Setup time RS/RW to EN min. 40ns
	LCD_EN_HIGH;
	_delay_us(1);
	LCD_EN_LOW;

	sei();
}


//----------------------------------------
bool LCD_Busy(void)
{
	uint8_t inByte;
	// read cmd explicitly NOT calling LCD_ReadCmdReg, otherwise infinite loop
	cli();
	LCD_DATAPORT_DIR = 0x00;
	LCD_RS_CMD;
	LCD_RW_HIGH;
	_delay_us(1);

	LCD_EN_HIGH;
	_delay_us(1);
	inByte = LCD_DATAPORT_IN;
	LCD_EN_LOW;

	LCD_DATAPORT_DIR = 0xFF; // for better traceability during development: set to defined level
	LCD_DATAPORT_OUT = 0x00;
	sei();
 	if (inByte & 0x80) // D7 = busy
 		return true;
 	else
 		return false;
}


//-----------------------------------------------
void LCD_WaitBusy(void) // waits as long as LCD is busy
{
	uint8_t inByte;
	LCD_DATAPORT_DIR = 0x00;
	LCD_RS_CMD;
	LCD_RW_HIGH;
	do
	{
		LCD_EN_HIGH;
		_delay_us(1);
		inByte = LCD_DATAPORT_IN;
		LCD_EN_LOW;
	} while (inByte & 0x80);
	LCD_DATAPORT_DIR = 0xFF; // for better traceability during development: set to defined level
	LCD_DATAPORT_OUT = 0x00;
	return;
}


//----------------------------------------
void LCD_Home (void)
{
	LCD_WriteCmdReg(0x02);
}


//----------------------------------------
void LCD_Clear (void)
{
	LCD_WriteCmdReg(0x01);
}


//----------------------------------------
void LCD_PrintStr(char * Str)
{
	while (*Str!=0)
	{
		LCD_WriteDataReg((uint8_t)*Str);
		Str++;
	}
}
// End LCD -------------------------------


//----------------------------------------
void LCD_PrintCh(char ch)
{
	LCD_WriteDataReg((uint8_t)ch);
}
